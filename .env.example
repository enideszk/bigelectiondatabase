# Copy this file to .env and fill in the password. .env is gitignored.
# The same .env works on Server-PC and on any PC that reaches it over the LAN.

# Main database (PostgreSQL 18 + PostGIS on Server-PC, see docs/server-setup.md)
DATABASE_URL=postgresql://hudata:CHANGE_ME@192.168.0.253:5432/hu_data

# Throwaway database for `pytest`; it is wiped on every test run.
TEST_DATABASE_URL=postgresql://hudata:CHANGE_ME@192.168.0.253:5432/hu_data_test

# Optional: keep big downloads somewhere else (e.g. on the NAS). Defaults: data/raw, data/interim
# RAW_DATA_DIR=Y:\hu-data\raw
# INTERIM_DATA_DIR=Y:\hu-data\interim

# Optional: `npm run dev` polls for file changes by default, because native watching over the
# network share breaks file saves on Server-PC. On a local disk, 0 switches to native watching.
# VITE_USE_POLLING=0
